+static bool imuSample(float a[3], float g[3]) {
+  uint8_t d[14];
+  if (!mpuRead(0x3B, d, 14)) return false;
+  int16_t r[7];
+  for (int i = 0; i < 7; i++) r[i] = (int16_t)((d[2 * i] << 8) | d[2 * i + 1]);
+  a[0] = r[0] / 8192.0f;  a[1] = r[1] / 8192.0f;  a[2] = r[2] / 8192.0f;   // +-4 g
